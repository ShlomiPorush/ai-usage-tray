<Window x:Class="costats.App.GlassWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        xmlns:views="clr-namespace:costats.App.Views"
        Title="costats"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolNegationConverter x:Key="BoolNegationConverter" />

        <!-- The Claude and Codex glyphs, the refresh icon and the IconButton
             style are shared with the usage window: see Themes/Controls.xaml. -->

        <!-- Copilot icon (SVG path) -->
        <Geometry x:Key="CopilotIconPath">M95.667 67.954C92.225 73.933 72.24 88.04 47.997 88.04 23.754 88.04 3.769 73.933.328 67.954c-.216-.375-.307-.796-.328-1.226V55.661c.019-.371.089-.736.226-1.081 1.489-3.738 5.386-9.166 10.417-10.623.667-1.712 1.655-4.215 2.576-6.062-.154-1.414-.208-2.872-.208-4.345 0-5.322 1.128-9.99 4.527-13.466 1.587-1.623 3.557-2.869 5.893-3.805 5.595-4.545 13.563-8.369 24.48-8.369s19.057 3.824 24.652 8.369c2.337.936 4.306 2.182 5.894 3.805 3.399 3.476 4.527 8.144 4.527 13.466 0 1.473-.054 2.931-.208 4.345.921 1.847 1.909 4.35 2.576 6.062 5.03 1.457 8.928 6.885 10.417 10.623.163.41.231.848.231 1.289v10.644c0 .504-.081 1.004-.333 1.441ZM48.686 43.993l-.3.001-1.077-.001c-.423.709-.894 1.39-1.418 2.035-3.078 3.787-7.672 5.964-14.026 5.964-6.897 0-11.952-1.435-15.123-5.032a7.886 7.886 0 0 1-.342-.419l-.39.419v26.326c5.737 3.118 18.05 8.713 31.987 8.713 13.938 0 26.251-5.595 31.988-8.713V46.96l-.39-.419s-.132.181-.342.419c-3.171 3.597-8.226 5.032-15.123 5.032-6.354 0-10.949-2.177-14.026-5.964a17.178 17.178 0 0 1-1.418-2.034h-.066l.066-.001Zm-3.94-11.733c.17-1.326.251-2.513.253-3.573v-.084c-.005-3.077-.678-5.079-1.752-6.308-1.365-1.562-4.184-2.758-10.127-2.115-6.021.652-9.386 2.146-11.294 4.098-1.847 1.889-2.818 4.715-2.818 9.272 0 4.842.698 7.703 2.232 9.443 1.459 1.655 4.332 3.001 10.625 3.001 4.837 0 7.603-1.573 9.371-3.749 1.899-2.336 2.967-5.759 3.51-9.985Zm6.503 0c.543 4.226 1.611 7.649 3.51 9.985 1.768 2.176 4.533 3.749 9.371 3.749 6.292 0 9.165-1.346 10.624-3.001 1.535-1.74 2.232-4.601 2.232-9.443 0-4.557-.97-7.383-2.817-9.272-1.908-1.952-5.274-3.446-11.294-4.098-5.943-.643-8.763.553-10.127 2.115-1.074 1.229-1.747 3.231-1.752 6.308v.084c.002 1.06.083 2.247.253 3.573Zm-2.563 11.734h.066l-.066-.001v.001Z</Geometry>
        <Geometry x:Key="CopilotIconPathDetail">M38.5 55.75a3.5 3.5 0 0 1 3.5 3.5v8.5a3.5 3.5 0 1 1-7 0v-8.5a3.5 3.5 0 0 1 3.5-3.5Zm19 0a3.5 3.5 0 0 1 3.5 3.5v8.5a3.5 3.5 0 1 1-7 0v-8.5a3.5 3.5 0 0 1 3.5-3.5Z</Geometry>

        <!-- Lucide Loader icon (8 radiating lines) -->
        <Geometry x:Key="LoaderIconPath">M12,2 L12,6 M16.2,7.8 L19.1,4.9 M18,12 L22,12 M16.2,16.2 L19.1,19.1 M12,18 L12,22 M4.9,19.1 L7.8,16.2 M2,12 L6,12 M4.9,4.9 L7.8,7.8</Geometry>

        <!-- Settings icon (gear) -->
        <Geometry x:Key="SettingsIconPath">M19.14,12.94a7.14,7.14,0,0,0,.05-.94,7.14,7.14,0,0,0-.05-.94l2.11-1.65a.5.5,0,0,0,.12-.63l-2-3.46a.5.5,0,0,0-.6-.22l-2.49,1a7.28,7.28,0,0,0-1.63-.94l-.38-2.65A.5.5,0,0,0,13.78,2H10.22a.5.5,0,0,0-.5.42L9.34,5.07a7.28,7.28,0,0,0-1.63.94l-2.49-1a.5.5,0,0,0-.6.22l-2,3.46a.5.5,0,0,0,.12.63L4.85,11.06a7.14,7.14,0,0,0-.05.94,7.14,7.14,0,0,0,.05.94L2.74,14.59a.5.5,0,0,0-.12.63l2,3.46a.5.5,0,0,0,.6.22l2.49-1a7.28,7.28,0,0,0,1.63.94l.38,2.65a.5.5,0,0,0,.5.42h3.56a.5.5,0,0,0,.5-.42l.38-2.65a7.28,7.28,0,0,0,1.63-.94l2.49,1a.5.5,0,0,0,.6-.22l2-3.46a.5.5,0,0,0-.12-.63Zm-7.14,2.6A3.54,3.54,0,1,1,15.54,12,3.54,3.54,0,0,1,12,15.54Z</Geometry>

        <!-- Remote view icon (globe) -->
        <Geometry x:Key="RemoteViewIconPath">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.78 4.21,10.21L9,15V16A2,2 0 0,0 11,18M17.9,17.39C17.64,16.58 16.9,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39Z</Geometry>

        <!-- Percent pill: a soft 18 percent band tint behind the number, no
             ring. The sliver of vertical padding replaces the height the
             smaller percent number gave up, so rows keep their old height. -->
        <Style x:Key="PercentPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0.7" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Text link inside a section header ("More" on the Usage section) -->
        <Style x:Key="SectionLinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar style -->
        <Style x:Key="UsageProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="{TemplateBinding Background}" />
                            <!-- Plain vivid fill, no edge stroke, in both themes. -->
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource WidgetBgBrush}">
        <Grid>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Header: overview title, or back button + account name in detail view -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0"
                        Command="{Binding BackToOverviewCommand}" ToolTip="All accounts"
                        Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Cursor="Hand" Padding="0"
                        Visibility="{Binding IsOverview, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <TextBlock Text="&#x2190;" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- One-click remote view: only on the overview, and only once
                     remote view is on and the share link exists. -->
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                        Command="{Binding OpenRemoteViewCommand}" ToolTip="Open remote view">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsOverview}" Value="True" />
                                        <Condition Binding="{Binding CanOpenRemoteView}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="{StaticResource RemoteViewIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <!-- Usage dashboard: overview only, sits left of the globe. -->
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                        Click="OnUsageStatsClick" ToolTip="Usage stats"
                        Visibility="{Binding IsOverview, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                        Style="{StaticResource IconButton}">
                    <Path Data="{StaticResource UsageStatsIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedAccount.DisplayName}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverview}" Value="True">
                                        <Setter Property="Text" Value="AI usage" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

            <!-- Overview: one clickable card per account.
                 In detail mode it goes Hidden (not Collapsed) so it keeps
                 reserving its layout space; that pins the window height across
                 overview <-> detail switches and stops the widget from
                 shrinking and drifting away from the taskbar corner. -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="IsHitTestVisible" Value="True" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverview}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,8"
                                    HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CardBorder" Background="{DynamicResource CardBgBrush}" CornerRadius="10"
                                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                Visibility="{Binding PlanText, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1F10B981" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProviderKind}" Value="claude">
                                                            <Setter Property="Background" Value="#1FF97316" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                                            <Setter Property="Background" Value="#1F64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PlanText}" FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <!-- Redeemable usage-limit resets; quiet, and only when there is one -->
                                        <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource KindBadgeBrush}"
                                                Visibility="{Binding HasResetCredits, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding ResetCreditsChipText}" FontSize="9.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding OverallStatusColor}" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock DockPanel.Dock="Left" Text="&#x2605;" FontSize="11" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource SessionAccent}" VerticalAlignment="Center"
                                                   ToolTip="Primary account"
                                                   Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Session row -->
                                    <DockPanel Margin="0,0,0,4"
                                               Visibility="{Binding HasSessionData, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Session" FontSize="10.5" Width="48" Foreground="{DynamicResource TextMutedBrush}"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Grid DockPanel.Dock="Right" Width="46">
                                            <Border Style="{StaticResource PercentPill}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding SessionPercentPillColor}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding SessionPercentText}" FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding SessionPercentColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding SessionResetText}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,4,0"
                                                   Visibility="{Binding DataContext.ShowResetTimes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ProgressBar Style="{StaticResource UsageProgressBar}" Height="6"
                                                     Value="{Binding SessionProgress}" Maximum="1" VerticalAlignment="Center">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="{Binding SessionStatusColor}" />
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </DockPanel>

                                    <!-- Weekly row -->
                                    <DockPanel Visibility="{Binding HasWeekData, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Weekly" FontSize="10.5" Width="48" Foreground="{DynamicResource TextMutedBrush}"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <Grid DockPanel.Dock="Right" Width="46">
                                            <Border Style="{StaticResource PercentPill}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding WeekPercentPillColor}" />
                                                </Border.Background>
                                                <TextBlock Text="{Binding WeekPercentText}" FontSize="10.5" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding WeekPercentColor}" />
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding WeekResetText}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,4,0"
                                                   Visibility="{Binding DataContext.ShowResetTimes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ProgressBar Style="{StaticResource UsageProgressBar}" Height="6"
                                                     Value="{Binding WeekProgress}" Maximum="1" VerticalAlignment="Center">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="{Binding WeekStatusColor}" />
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </DockPanel>

                                    <!-- Model-scoped limits (e.g. Fable weekly) -->
                                    <ItemsControl ItemsSource="{Binding ScopedLimits}" Focusable="False"
                                                  Visibility="{Binding HasScopedLimits, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding GroupLabel}" FontSize="10.5" Width="48"
                                                               Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                               DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                    <!-- Model chip: what separates a model's Weekly from the account's Weekly -->
                                                    <Border DockPanel.Dock="Left" CornerRadius="4" BorderThickness="1" Padding="5,0"
                                                            Margin="0,0,8,0" MaxWidth="84" VerticalAlignment="Center"
                                                            Background="{DynamicResource KindBadgeBrush}"
                                                            BorderBrush="{DynamicResource DividerBrush}"
                                                            ToolTip="{Binding Label}">
                                                        <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                    <Grid DockPanel.Dock="Right" Width="46">
                                                        <Border Style="{StaticResource PercentPill}">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding PillColor}" />
                                                            </Border.Background>
                                                            <TextBlock Text="{Binding PercentText}" FontSize="10.5" FontWeight="SemiBold">
                                                                <TextBlock.Foreground>
                                                                    <SolidColorBrush Color="{Binding PercentColor}" />
                                                                </TextBlock.Foreground>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ResetText}" FontSize="9.5" Foreground="{DynamicResource TextFaintBrush}"
                                                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,4,0"
                                                               Visibility="{Binding DataContext.ShowResetTimes, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    <ProgressBar Style="{StaticResource UsageProgressBar}" Height="6"
                                                                 Value="{Binding Progress, Mode=OneWay}" Maximum="1"
                                                                 VerticalAlignment="Center">
                                                        <ProgressBar.Foreground>
                                                            <SolidColorBrush Color="{Binding BarColor}" />
                                                        </ProgressBar.Foreground>
                                                    </ProgressBar>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Status line when no quota data -->
                                    <TextBlock Text="{Binding StatusSummary}" FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasSessionData}" Value="False" />
                                                            <Condition Binding="{Binding HasWeekData}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Detail view for the selected account -->
            <StackPanel Grid.Row="2" DataContext="{Binding SelectedAccount}"
                        Visibility="{Binding DataContext.IsOverview, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">

                <!-- Provider header -->
                <DockPanel Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding StatusSummary}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <!-- Plan chip badge (only visible when PlanText is not empty) -->
                    <Border x:Name="PlanChip" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Top"
                            CornerRadius="4" BorderThickness="1" Padding="6,2"
                            Visibility="{Binding PlanText, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Default: Codex green -->
                                <Setter Property="BorderBrush" Value="{DynamicResource CodexAccent}" />
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#10B981" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Claude: orange -->
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="claude">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ClaudeAccent}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#F97316" Opacity="0.12" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <!-- Copilot: slate -->
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                        <Setter Property="BorderBrush" Value="{DynamicResource CopilotAccent}" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#64748B" Opacity="0.12" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding PlanText}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Default: Codex - dark green for contrast -->
                                    <Setter Property="Foreground" Value="{DynamicResource PlanCodexFgBrush}" />
                                    <Style.Triggers>
                                        <!-- Claude: dark orange for contrast -->
                                        <DataTrigger Binding="{Binding ProviderKind}" Value="claude">
                                            <Setter Property="Foreground" Value="{DynamicResource PlanClaudeFgBrush}" />
                                        </DataTrigger>
                                        <!-- Copilot: dark slate for contrast -->
                                        <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                            <Setter Property="Foreground" Value="{DynamicResource PlanCopilotFgBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DockPanel>

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />

                <!-- Session section -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding HasSessionData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Session" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                        <Setter Property="Text" Value="Premium requests" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Style="{StaticResource UsageProgressBar}" Value="{Binding SessionProgress}" Maximum="1">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="{Binding SessionStatusColor}" />
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding SessionUsageLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding SessionResetText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>

                <!-- Weekly section -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding HasWeekData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Weekly" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                        <Setter Property="Text" Value="Chat requests" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Style="{StaticResource UsageProgressBar}" Value="{Binding WeekProgress}" Maximum="1">
                        <ProgressBar.Foreground>
                            <SolidColorBrush Color="{Binding WeekStatusColor}" />
                        </ProgressBar.Foreground>
                    </ProgressBar>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding WeekUsageLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding WeekResetText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                    <TextBlock Text="{Binding WeekPaceText}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,4,0,0"
                               Visibility="{Binding WeekPaceText, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Hyperlink NavigateUri="https://github.com/settings/copilot/features"
                                   RequestNavigate="OnUsageLinkNavigate">
                            View Copilot usage on GitHub
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="codex">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Hyperlink NavigateUri="https://chatgpt.com/codex/settings/usage"
                                   RequestNavigate="OnUsageLinkNavigate">
                            View Codex usage on ChatGPT
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ProviderKind}" Value="claude">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Hyperlink NavigateUri="https://claude.ai/settings/usage"
                                   RequestNavigate="OnUsageLinkNavigate">
                            View Claude usage
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Redeemable usage-limit resets. Display only: the app never
                     spends one, the Codex CLI does. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16"
                            Visibility="{Binding HasResetCredits, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                             Fill="{DynamicResource AccentBrush}" />
                    <TextBlock Text="{Binding ResetCreditsText}" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Model-scoped limits section (e.g. Fable weekly limit) -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding HasScopedLimits, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Model limits" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ScopedLimits}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding GroupLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                                        <!-- Model chip: what separates a model's Weekly from the account's Weekly -->
                                        <Border DockPanel.Dock="Left" CornerRadius="4" BorderThickness="1" Padding="6,1"
                                                Margin="8,0,8,0" MaxWidth="160" VerticalAlignment="Center"
                                                Background="{DynamicResource KindBadgeBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                ToolTip="{Binding Label}">
                                            <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <Border Style="{StaticResource PercentPill}" DockPanel.Dock="Right">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding PillColor}" />
                                            </Border.Background>
                                            <TextBlock Text="{Binding PercentText}" FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding PercentColor}" />
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                    </DockPanel>
                                    <ProgressBar Style="{StaticResource UsageProgressBar}"
                                                 Value="{Binding Progress, Mode=OneWay}" Maximum="1">
                                        <ProgressBar.Foreground>
                                            <SolidColorBrush Color="{Binding BarColor}" />
                                        </ProgressBar.Foreground>
                                    </ProgressBar>
                                    <TextBlock Text="{Binding ResetText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0" HorizontalAlignment="Right"
                                               Visibility="{Binding ResetText, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider (shares the Usage section's visibility: no cost data, no divider) -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,16"
                        Visibility="{Binding HasCostData, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Usage section -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProviderKind}" Value="copilot">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- Stays hidden until the usage engine answers, so the
                                     rows never render as empty placeholders -->
                                <DataTrigger Binding="{Binding HasCostData}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Usage" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <!-- Opens the usage window already filtered to this account -->
                        <Button DockPanel.Dock="Right" Content="More" VerticalAlignment="Center"
                                Style="{StaticResource SectionLinkButton}"
                                Click="OnAccountUsageClick"
                                ToolTip="Open the usage window for this account" />
                        <!-- Codex logs cannot be split per profile: say whose numbers these are -->
                        <TextBlock Text="{Binding CostScopeNote}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   DockPanel.Dock="Right" Margin="8,0,8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding CostScopeNote, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left">
                            <Run Text="Today:" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TodayCostText}" FontSize="12" Foreground="{DynamicResource CostTodayAccent}" FontWeight="SemiBold" />
                            <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding TodayTokensText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                    <DockPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Left">
                            <Run Text="Last 30 days:" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MonthCostText}" FontSize="12" Foreground="{DynamicResource CostMonthAccent}" FontWeight="SemiBold" />
                            <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding MonthTokensText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

            </StackPanel>

            <!-- Footer: divider plus the right-aligned Refresh / Settings buttons -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />
                <DockPanel HorizontalAlignment="Right" LastChildFill="False">
                    <Button Style="{StaticResource IconButton}" DockPanel.Dock="Right"
                            ToolTip="Settings" VerticalAlignment="Top"
                            Click="OnSettingsClick">
                        <Path Data="{StaticResource SettingsIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <!-- Refresh button sits to the left of Settings -->
                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                            DockPanel.Dock="Right" Margin="0,0,6,0"
                            ToolTip="Refresh now" VerticalAlignment="Top"
                            IsEnabled="{Binding IsRefreshing, Converter={StaticResource BoolNegationConverter}}">
                        <Path Data="{StaticResource RefreshIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </DockPanel>
            </StackPanel>
            </Grid>

            <!-- Loading spinner (top-right corner, non-blocking) -->
            <Path x:Name="LoadingSpinner"
                  Data="{StaticResource LoaderIconPath}"
                  Stroke="{DynamicResource TextMutedBrush}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Stretch="Uniform"
                  Width="14" Height="14"
                  Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="0,6,6,0"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform>
                    <RotateTransform Angle="0" />
                </Path.RenderTransform>
                <Path.Style>
                    <Style TargetType="Path">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Path.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
        </Grid>
    </Border>
        </Window>
