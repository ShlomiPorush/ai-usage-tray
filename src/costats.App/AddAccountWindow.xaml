<Window x:Class="costats.App.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBgBrush}">
        <StackPanel Margin="20">
            <TextBlock x:Name="TitleText" Text="Add account" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBlock Text="Pick a provider; only the fields that provider needs are shown."
                       FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />

            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged"
                      Padding="10,7" FontSize="12" SelectedIndex="0">
                <ComboBoxItem Content="Claude" Tag="claude" />
                <ComboBoxItem Content="OpenAI Codex" Tag="codex" />
                <ComboBoxItem Content="Z.AI / GLM" Tag="zai" />
                <ComboBoxItem Content="GitHub Copilot" Tag="copilot" />
            </ComboBox>

            <StackPanel x:Name="NamePanel">
                <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" MaxLength="24" Style="{StaticResource FieldBox}" />
            </StackPanel>

            <!-- Claude / Codex: profile folder -->
            <StackPanel x:Name="FolderPanel">
                <TextBlock x:Name="FolderLabel" Text="Profile folder (CLAUDE_CONFIG_DIR)" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button Content="..." DockPanel.Dock="Right" Width="34" Margin="6,0,0,0"
                            Click="OnBrowseClick" Style="{StaticResource DialogButton}" Padding="0,6" />
                    <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}" FontFamily="Consolas" FontSize="10" />
                </DockPanel>
                <TextBlock x:Name="FolderHint" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Z.AI / Copilot: secret -->
            <StackPanel x:Name="SecretPanel" Visibility="Collapsed">
                <TextBlock x:Name="SecretLabel" Text="API key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SecretBox" Padding="10,7" FontSize="12" />
                <TextBlock x:Name="SecretHint" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#DC2626" Margin="0,10,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <DockPanel Margin="0,18,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource DialogButton}" DockPanel.Dock="Left" />
                <Button x:Name="ConfirmButton" Content="Add" Click="OnAddClick" Style="{StaticResource DialogButton}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"
                        Background="#206366F1" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
