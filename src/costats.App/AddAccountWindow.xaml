<Window x:Class="costats.App.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account"
        Width="500"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <!-- Same type scale and controls as the Settings window it opens from. -->
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,18,0,7" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" Background="{DynamicResource PanelBgBrush}">
        <StackPanel Margin="30,28,30,26">
            <TextBlock x:Name="TitleText" Text="Add account" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="Pick a provider; only the fields that provider needs are shown."
                       FontSize="13.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,4" />

            <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged" SelectedIndex="0"
                      AutomationProperties.Name="Provider">
                <ComboBoxItem Content="Claude" Tag="claude" />
                <ComboBoxItem Content="OpenAI Codex" Tag="codex" />
                <ComboBoxItem Content="Z.AI / GLM" Tag="zai" />
                <ComboBoxItem Content="GitHub Copilot" Tag="copilot" />
                <ComboBoxItem Content="Google Antigravity" Tag="antigravity" />
            </ComboBox>

            <StackPanel x:Name="NamePanel">
                <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" MaxLength="24" Style="{StaticResource FieldBox}"
                         AutomationProperties.Name="Display name" />
            </StackPanel>

            <!-- Claude / Codex: profile folder -->
            <StackPanel x:Name="FolderPanel">
                <TextBlock x:Name="FolderLabel" Text="Profile folder (CLAUDE_CONFIG_DIR)" Style="{StaticResource FieldLabel}" />
                <DockPanel>
                    <Button Content="..." DockPanel.Dock="Right" Width="46" Margin="8,0,0,0" Padding="0"
                            Click="OnBrowseClick" Style="{StaticResource DialogButton}"
                            ToolTip="Browse for a folder" AutomationProperties.Name="Browse for a folder" />
                    <TextBox x:Name="FolderBox" Style="{StaticResource FieldBox}" FontFamily="Consolas" FontSize="13"
                             AutomationProperties.LabeledBy="{Binding ElementName=FolderLabel}" />
                </DockPanel>
                <TextBlock x:Name="FolderHint" Style="{StaticResource FieldHint}" />
            </StackPanel>

            <!-- Z.AI / Copilot: secret -->
            <StackPanel x:Name="SecretPanel" Visibility="Collapsed">
                <TextBlock x:Name="SecretLabel" Text="API key" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="SecretBox" AutomationProperties.LabeledBy="{Binding ElementName=SecretLabel}" />
                <TextBlock x:Name="SecretHint" Style="{StaticResource FieldHint}" />
            </StackPanel>

            <!-- Antigravity: the agy CLI, no secret -->
            <StackPanel x:Name="AntigravityPanel" Visibility="Collapsed">
                <TextBlock x:Name="AntigravityStatusText" FontSize="13" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,18,0,0" />
                <TextBlock Text="Check at most every (minutes)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="AntigravityIntervalBox" MaxLength="3" Width="96" HorizontalAlignment="Left"
                         Style="{StaticResource FieldBox}" TextChanged="OnAntigravityIntervalChanged"
                         AutomationProperties.Name="Check at most every (minutes)" />
                <TextBlock Text="From 5 to 240 minutes. Each check runs agy for a few seconds."
                           Style="{StaticResource FieldHint}" />
            </StackPanel>
            <TextBlock x:Name="ErrorText" FontSize="13" Foreground="#DC2626" Margin="0,14,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <DockPanel Margin="0,26,0,0">
                <Button Content="Cancel" Click="OnCancelClick" Style="{StaticResource DialogButton}" DockPanel.Dock="Left" />
                <Button x:Name="ConfirmButton" Content="Add" Click="OnAddClick" Style="{StaticResource PrimaryDialogButton}"
                        DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="96" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
