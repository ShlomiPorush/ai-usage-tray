<Window x:Class="costats.App.Services.TrayStatusPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        Left="-10000"
        Top="-10000"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="OnMouseLeftButtonDown">

    <Border CornerRadius="11"
            Background="{DynamicResource FloatingPanelBgBrush}"
            BorderBrush="{DynamicResource FloatingPanelBorderBrush}"
            BorderThickness="1"
            Padding="12,7,8,7">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="StatusRowsPanel"
                        Grid.Column="0"
                        MaxWidth="520"
                        VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Width="22"
                    Height="22"
                    Margin="10,0,0,0"
                    Padding="0"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    ToolTip="Close floating status panel"
                    Click="OnCloseClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" CornerRadius="5" Background="Transparent">
                            <TextBlock Text="&#x00D7;"
                                       FontFamily="Segoe UI"
                                       FontSize="17"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource FloatingPanelCloseHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource FloatingPanelClosePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
