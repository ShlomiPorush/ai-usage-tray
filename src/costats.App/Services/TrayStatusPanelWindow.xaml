<Window x:Class="costats.App.Services.TrayStatusPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        Always-on-top, non-interactive, transparent panel that lives next to
        the system clock. The panel exposes a single TextBlock whose content
        is the resolved TrayStatus.Tooltip. It updates on every PulseState
        publish, so the user can read all three provider quotas at a glance
        without hovering the tray icon.
    -->
    <Border CornerRadius="4"
            Background="{DynamicResource PanelBgBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            Padding="8,3"
            SnapsToDevicePixels="True">
        <TextBlock x:Name="StatusText"
                   FontFamily="Segoe UI"
                   FontSize="11"
                   Foreground="#1E1B2E"
                   VerticalAlignment="Center"
                   TextAlignment="Left"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="520"
                   Text="AI Usage Tray · loading…" />
    </Border>
</Window>