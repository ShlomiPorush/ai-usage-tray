<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>costats.App</RootNamespace>
    <AssemblyName>AIUsageTray</AssemblyName>

    <!-- App metadata -->
    <Product>AI Usage Tray</Product>
    <Description>One-icon tray monitor for a Claude subscription, two OpenAI Codex accounts and Z.AI/GLM. Fork of fmdz387/costats.</Description>
    <Company>Shlomi Porush</Company>
    <Authors>Shlomi Porush, fmdz (upstream costats)</Authors>
    <Copyright>Copyright (c) 2026 Shlomi Porush. Multi-account architecture (c) 2026 Yoav Yechiam / Product Alliance. Based on costats, Copyright (c) 2026 fmdz (MIT).</Copyright>
    <RepositoryUrl>https://github.com/ShlomiPorush/ai-usage-tray</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ShlomiPorush/ai-usage-tray</PackageProjectUrl>

    <!-- Publishing configuration -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- ReadyToRun disabled for smaller size (saves ~6MB, minimal startup impact for tray app) -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>

    <!-- Windows-specific -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Exclude unnecessary files from publish -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <!-- Size optimization (trimming not supported with WPF) -->
    <!-- InvariantGlobalization reduces size but disables culture-specific formatting -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\costats.Application\\costats.Application.csproj" />
    <ProjectReference Include="..\\costats.Infrastructure\\costats.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NHotkey.Wpf" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Copied for local F5 runs only; a shipped build must never carry it. -->
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="Services\Updates\apply-update.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="apply-update.ps1" />
    <!-- Shipped next to the exe so the Add/remove programs entry has something to run. -->
    <Content Include="..\..\scripts\uninstall.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="uninstall.ps1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\tray-icon.ico" />
  </ItemGroup>

  <!-- Application icon -->
  <PropertyGroup>
    <ApplicationIcon>Resources\tray-icon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
