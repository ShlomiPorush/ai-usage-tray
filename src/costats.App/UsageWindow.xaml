<Window x:Class="costats.App.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        xmlns:controls="clr-namespace:costats.App.Controls"
        Title="Usage"
        Width="1180" Height="900"
        MinWidth="900" MinHeight="620"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WidgetBgBrush}">

    <!-- Themed chrome: the caption strip is ours, but the window stays a normal
         resizable, snappable, maximizable window. CaptionHeight matches the
         title bar row below, so dragging and double-click-to-maximize work
         without a line of code. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Caption buttons: flat, theme-brushed, full-height hit targets. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close keeps the same shape but warns on hover, in both themes. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#22EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#33EF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One segment of a 2 or 3 way toggle. The group is a rounded track;
             the checked segment gets the raised input surface. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" Background="Transparent" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource InputBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Thin provider share bar under each hero row. -->
        <Style x:Key="ShareBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Foreground" Value="{DynamicResource ClaudeAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Foreground" Value="{DynamicResource CodexAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Provider logo, tinted with that provider's accent. -->
        <Style x:Key="ProviderGlyph" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Data" Value="{StaticResource ClaudeIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource ClaudeAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Data" Value="{StaticResource CodexIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource CodexAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same glyph, table size, hidden for rows that are not per provider. -->
        <Style x:Key="RowGlyph" TargetType="Path" BasedOn="{StaticResource ProviderGlyph}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Data" Value="{StaticResource ClaudeIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource ClaudeAccent}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Data" Value="{StaticResource CodexIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource CodexAccent}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <!-- RootGrid's margin is swapped for the maximized state: a WindowChrome
         window is sized to the monitor including its resize border, so without
         the padding the maximized content would run under the screen edges and
         the taskbar. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Themed title bar, standing in for the native caption -->
        <Grid Grid.Row="0" Height="40" Background="{DynamicResource PanelBgBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource UsageStatsIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Usage" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Buttons have to opt out of the caption drag area, or the chrome
                 swallows their clicks. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0,5 H10" />
                </Button>
                <Button Click="OnMaximizeRestoreClick" AutomationProperties.Name="Maximize">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Value="Maximized"
                                             Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Style="{StaticResource CaptionGlyph}">
                        <Path.Data>
                            <Binding Path="WindowState" RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{x:Static local:WindowStateGlyphConverter.Instance}" />
                        </Path.Data>
                    </Path>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick"
                        ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header: range caption, account filter, range toggle, refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- An explicit ItemTemplate, not DisplayMemberPath: the app's
                     ComboBox template draws the selection through
                     SelectionBoxItemTemplate, which DisplayMemberPath leaves unset. -->
                <ComboBox Width="210" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          ToolTip="Filter by account">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <!-- Without this a screen reader announces the record's
                             ToString instead of the account name. -->
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=7}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=30}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="90 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=90}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" ToolTip="Re-read the local logs"
                        IsEnabled="{Binding IsLoading, Converter={x:Static local:BoolNegationConverter.Instance}}">
                    <Path Data="{StaticResource RefreshIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding RangeLabel}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="refreshing" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaintBrush}"
                           Visibility="{Binding IsLoading, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
            </StackPanel>
        </DockPanel>

        <!-- 2 + 3. Hero block and the daily chart -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="RAW TOKEN COST" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding TotalCostText}" FontSize="38" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="*" FontSize="38" FontWeight="Bold" Margin="1,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <TextBlock Text="* if billed at full API rate" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFaintBrush}" />
                <TextBlock Text="{Binding UnpricedNote}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFaintBrush}"
                           Visibility="{Binding UnpricedNote, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />

                <ItemsControl ItemsSource="{Binding ProviderRows}" Margin="0,20,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Path Style="{StaticResource ProviderGlyph}" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding Share, Mode=OneWay}" />
                                <TextBlock Text="{Binding Caption}" FontSize="11" Margin="0,7,0,0"
                                           Foreground="{DynamicResource TextFaintBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Metric" Content="COST"
                                         IsChecked="{Binding MetricIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Metric" Content="TOKENS"
                                         IsChecked="{Binding MetricIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ProviderRows}" Margin="0,0,16,0"
                                  VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource ProviderGlyph}" Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ChartTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </DockPanel>

                <controls:UsageChart Grid.Row="1" Height="260"
                                     Data="{Binding Chart}"
                                     ClaudeBrush="{DynamicResource ClaudeAccent}"
                                     CodexBrush="{DynamicResource CodexAccent}"
                                     GridBrush="{DynamicResource DividerBrush}"
                                     LabelBrush="{DynamicResource TextFaintBrush}" />
            </Grid>
        </Grid>

        <!-- 4. The five headline tiles -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Margin="0,0,-10,22" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Caption}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Footnote}" FontSize="11" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 5. Breakdown -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Breakdown" Content="MODEL"
                                     IsChecked="{Binding BreakdownIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Breakdown" Content="DAY"
                                     IsChecked="{Binding BreakdownIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Breakdown" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,14,0" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource TableHeader}" Text="{Binding BreakdownColumnHeader}" />
                <TextBlock Grid.Column="1" Style="{StaticResource TableHeader}" Text="{Binding BreakdownValueHeader}"
                           HorizontalAlignment="Right" />
                <TextBlock Grid.Column="2" Style="{StaticResource TableHeader}" Text="Share" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Style="{StaticResource TableHeader}" Text="Tokens" HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,4,0">
                <ItemsControl ItemsSource="{Binding BreakdownRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,9">
                                <Grid Margin="0,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Style="{StaticResource RowGlyph}" />
                                        <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Style="{StaticResource TableCell}" Text="{Binding ValueText}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource TableCell}" Text="{Binding ShareText}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource TableCell}" Text="{Binding TokensText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Empty / loading / error state, over the whole body -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource WidgetBgBrush}"
                Visibility="{Binding HasData, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding StatusText}" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </Border>
        </Grid>
    </Grid>
</Window>
