<Window x:Class="costats.App.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        xmlns:controls="clr-namespace:costats.App.Controls"
        Title="Usage"
        Width="1180" Height="900"
        MinWidth="900" MinHeight="620"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WidgetBgBrush}">

    <!-- Themed chrome: the caption strip is ours, but the window stays a normal
         resizable, snappable, maximizable window. CaptionHeight matches the
         title bar row below, so dragging and double-click-to-maximize work
         without a line of code. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Caption buttons: flat, theme-brushed, full-height hit targets. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close keeps the same shape but warns on hover, in both themes. -->
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#22EF4444" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#33EF4444" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One segment of a 2 or 3 way toggle. The group is a rounded track;
             the checked segment gets the raised input surface. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder" Background="Transparent" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource InputBgBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Thin provider share bar under each hero row. -->
        <Style x:Key="ShareBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{x:Static local:ProgressWidthConverter.Instance}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Foreground" Value="{DynamicResource ClaudeAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Foreground" Value="{DynamicResource CodexAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Provider logo, tinted with that provider's accent. -->
        <Style x:Key="ProviderGlyph" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Data" Value="{StaticResource ClaudeIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource ClaudeAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Data" Value="{StaticResource CodexIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource CodexAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same glyph, table size, hidden for rows that are not per provider. -->
        <Style x:Key="RowGlyph" TargetType="Path" BasedOn="{StaticResource ProviderGlyph}">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Data" Value="{StaticResource ClaudeIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource ClaudeAccent}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Data" Value="{StaticResource CodexIconPath}" />
                    <Setter Property="Fill" Value="{DynamicResource CodexAccent}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,13" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="TableHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- A change against the comparison period. Neutral on purpose: more
             usage is not good or bad by itself. -->
        <Style x:Key="DeltaText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
        </Style>

        <!-- A segment that opens a popup instead of switching a value. It looks
             checked while what it opens is the state on screen. -->
        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomRangeSegment" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCustomRange}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompareSegment" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
            <Setter Property="AutomationProperties.Name" Value="Compare" />
            <Style.Triggers>
                <!-- Alone in its group, a plain checked look is easy to miss,
                     so an active comparison also takes the accent colour, and
                     a screen reader hears the same state the label shows. -->
                <DataTrigger Binding="{Binding IsComparing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="AutomationProperties.Name" Value="Comparing" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One of the two periods in the comparison picker. The checked one is
             the period the calendar is editing. -->
        <Style x:Key="PeriodChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="8" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource KindBadgeBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPopupButton" TargetType="Button" BasedOn="{StaticResource PopupButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Small text link, for Back and for turning the comparison off. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A clickable column header; the arrow beside the text shows the sort. -->
        <Style x:Key="SortHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderBorder" Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="Transparent" Padding="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A breakdown row. Day rows open that day by hour and model rows open
             the model's details; hour rows are inert. -->
        <Style x:Key="BreakdownRow" TargetType="Button">
            <Setter Property="Focusable" Value="{Binding CanOpen}" />
            <Setter Property="IsEnabled" Value="{Binding CanOpen}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DrillName}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="Transparent" CornerRadius="4"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanOpen}" Value="True">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Both charts share their theme brushes, tooltip included. -->
        <Style x:Key="ThemedUsageChart" TargetType="controls:UsageChart">
            <Setter Property="ClaudeBrush" Value="{DynamicResource ClaudeAccent}" />
            <Setter Property="CodexBrush" Value="{DynamicResource CodexAccent}" />
            <Setter Property="GridBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="LabelBrush" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="TooltipBackground" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="TooltipBorderBrush" Value="{DynamicResource WindowBorderBrush}" />
            <Setter Property="TextBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SecondaryTextBrush" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <!-- A by-type bar in the model's accent. -->
        <Style x:Key="ModelSplitBar" TargetType="controls:UsageSplitBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,10,0,10" />
            <Setter Property="TrackBrush" Value="{DynamicResource TrackBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ProviderKey}" Value="claude">
                    <Setter Property="Brush" Value="{DynamicResource ClaudeAccent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderKey}" Value="codex">
                    <Setter Property="Brush" Value="{DynamicResource CodexAccent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="DetailFigure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="DetailSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- The legend under a by-type bar: a swatch in its segment's shade,
             the type and the figure. -->
        <DataTemplate x:Key="SplitLegendItem">
            <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                <Border Width="8" Height="8" CornerRadius="2" Margin="0,1,7,0" VerticalAlignment="Center"
                        Opacity="{Binding Opacity}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ProviderKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="claude">
                                    <Setter Property="Background" Value="{DynamicResource ClaudeAccent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.ProviderKey, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="codex">
                                    <Setter Property="Background" Value="{DynamicResource CodexAccent}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding ValueText}" FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapItems">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <!-- RootGrid's margin is swapped for the maximized state: a WindowChrome
         window is sized to the monitor including its resize border, so without
         the padding the maximized content would run under the screen edges and
         the taskbar. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. Themed title bar, standing in for the native caption -->
        <Grid Grid.Row="0" Height="40" Background="{DynamicResource PanelBgBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Path Data="{StaticResource UsageStatsIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="Usage and estimated API value" FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Buttons have to opt out of the caption drag area, or the chrome
                 swallows their clicks. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick"
                        ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0,5 H10" />
                </Button>
                <Button Click="OnMaximizeRestoreClick" AutomationProperties.Name="Maximize">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="ToolTip" Value="Maximize" />
                            <Style.Triggers>
                                <DataTrigger Value="Maximized"
                                             Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Setter Property="ToolTip" Value="Restore" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Style="{StaticResource CaptionGlyph}">
                        <Path.Data>
                            <Binding Path="WindowState" RelativeSource="{RelativeSource AncestorType=Window}"
                                     Converter="{x:Static local:WindowStateGlyphConverter.Instance}" />
                        </Path.Data>
                    </Path>
                </Button>
                <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick"
                        ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0,0 L10,10 M10,0 L0,10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header: range caption, account filter, range toggle, refresh -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- An explicit ItemTemplate, not DisplayMemberPath: the app's
                     ComboBox template draws the selection through
                     SelectionBoxItemTemplate, which DisplayMemberPath leaves unset. -->
                <ComboBox Width="210" Margin="0,0,10,0" VerticalAlignment="Center"
                          ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                          ToolTip="Filter by account">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemContainerStyle>
                        <!-- Without this a screen reader announces the record's
                             ToString instead of the account name. -->
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>
                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="Past 24h"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="7 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=7}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="30 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=30}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Range" Content="90 days"
                                     IsChecked="{Binding RangeDays, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=90}" />
                        <Button x:Name="CustomRangeButton" Style="{StaticResource CustomRangeSegment}"
                                Click="OnCustomRangeClick" ToolTip="Pick a day or a range of days"
                                AutomationProperties.Name="Custom range">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Custom" />
                                <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Margin="6,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SegmentGroup}" Margin="0,0,10,0">
                    <Button x:Name="CompareButton" Style="{StaticResource CompareSegment}"
                            Click="OnCompareClick" ToolTip="Compare with another period">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Compare" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsComparing}" Value="True">
                                                <Setter Property="Text" Value="Comparing" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Path Data="M0,0 L3.5,3.5 L7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3" Margin="6,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>
                <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" ToolTip="Re-read the local logs"
                        IsEnabled="{Binding IsLoading, Converter={x:Static local:BoolNegationConverter.Instance}}">
                    <Path Data="{StaticResource RefreshIconPath}" Fill="{DynamicResource TextSecondaryBrush}"
                          Stretch="Uniform" Width="14" Height="14" />
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <!-- Links that undo a view sit above the caption, so they never
                     take width from the controls on the right. -->
                <WrapPanel Orientation="Horizontal">
                    <Button Style="{StaticResource LinkButton}" Command="{Binding BackCommand}" Margin="0,0,16,2"
                            Visibility="{Binding CanGoBack, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,0 L0,4 L4,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BackLabel}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearFiltersButton" Style="{StaticResource LinkButton}"
                            Command="{Binding ClearFiltersCommand}" Margin="0,0,0,2"
                            ToolTip="Show every account for 30 days, without a comparison"
                            Visibility="{Binding HasFilters, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Clear filters" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding RangeLabel}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ComparisonLabel}" FontSize="13" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                               Visibility="{Binding ComparisonLabel, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                    <TextBlock Text="refreshing" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaintBrush}"
                               Visibility="{Binding IsLoading, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                </WrapPanel>
                <TextBlock Text="{Binding ComparisonNote}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFaintBrush}"
                           Visibility="{Binding ComparisonNote, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
            </StackPanel>
        </DockPanel>

        <!-- Custom range picker. The pending selection lives in the picker until
             Apply, so Cancel, Escape and a click outside change nothing. -->
        <Popup x:Name="RangePopup" PlacementTarget="{Binding ElementName=CustomRangeButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6"
               KeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupPanel}">
                <StackPanel>
                    <TextBlock Text="Show a day or a range" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Click the first day, then the last. A single day is shown by hour."
                               FontSize="11" TextWrapping="Wrap" Width="266" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFaintBrush}" />
                    <controls:DateRangePicker x:Name="RangePicker" SelectionChanged="OnRangePickerChanged" />
                    <TextBlock x:Name="RangeSelectionText" FontSize="12" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Style="{StaticResource PopupButton}" Content="Cancel" Click="OnRangeCancelClick" />
                        <Button x:Name="RangeApplyButton" Style="{StaticResource PrimaryPopupButton}" Content="Apply"
                                Click="OnRangeApplyClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Comparison picker: two periods picked freely, A against B. One
             calendar edits whichever period is active; the other one is
             underlined so both stay visible. -->
        <Popup x:Name="ComparePopup" PlacementTarget="{Binding ElementName=CompareButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6"
               KeyDown="OnPopupKeyDown">
            <Border Style="{StaticResource PopupPanel}">
                <StackPanel Width="266">
                    <TextBlock Text="Compare two periods" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Pick a period, then click the first day and the last."
                               FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaintBrush}" />
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <RadioButton x:Name="PeriodAOption" Style="{StaticResource PeriodChip}" GroupName="ComparePeriod"
                                     Margin="0,0,4,0" Checked="OnComparePeriodChecked"
                                     AutomationProperties.Name="Period A">
                            <StackPanel>
                                <TextBlock Text="PERIOD A" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="PeriodAText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PeriodBOption" Style="{StaticResource PeriodChip}" GroupName="ComparePeriod"
                                     Margin="4,0,0,0" Checked="OnComparePeriodChecked"
                                     AutomationProperties.Name="Period B">
                            <StackPanel>
                                <TextBlock Text="PERIOD B" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock x:Name="PeriodBText" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <controls:DateRangePicker x:Name="ComparePicker" SelectionChanged="OnComparePickerChanged" />
                    <TextBlock x:Name="CompareHintText" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaintBrush}" />
                    <TextBlock x:Name="CompareLengthNote" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaintBrush}"
                               Text="Different lengths: changes compare the average per day." />
                    <DockPanel Margin="0,12,0,0">
                        <Button x:Name="CompareOffButton" Style="{StaticResource LinkButton}" Content="Turn off"
                                Click="OnCompareOffClick" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PopupButton}" Content="Cancel" Click="OnCompareCancelClick" />
                            <Button x:Name="CompareApplyButton" Style="{StaticResource PrimaryPopupButton}" Content="Apply"
                                    Click="OnCompareApplyClick" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 2 + 3. Hero block and the daily chart -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,28,0">
                <TextBlock Text="{Binding HeroLabel}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding TotalCostText}" FontSize="38" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="*" FontSize="38" FontWeight="Bold" Margin="1,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding IsCostMetric, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="{Binding TotalPreviousText}" Style="{StaticResource DeltaText}" FontSize="12.5"
                               Margin="0,0,10,0" />
                    <TextBlock Text="{Binding TotalDeltaText}" Style="{StaticResource DeltaText}" FontSize="12.5" />
                </StackPanel>
                <TextBlock Text="{Binding HeroNote}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnpricedNote}" FontSize="11" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFaintBrush}"
                           Visibility="{Binding UnpricedNote, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />

                <ItemsControl ItemsSource="{Binding ProviderRows}" Margin="0,20,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <DockPanel Margin="0,0,0,7">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="13.5"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Path Style="{StaticResource ProviderGlyph}" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding Share, Mode=OneWay}" />
                                <DockPanel Margin="0,7,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DeltaText}" Style="{StaticResource DeltaText}"
                                               Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding Caption}" FontSize="11" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFaintBrush}" />
                                </DockPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="Metric" Content="API VALUE"
                                         IsChecked="{Binding MetricIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="Metric" Content="TOKENS"
                                         IsChecked="{Binding MetricIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                        </StackPanel>
                    </Border>
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ProviderRows}" Margin="0,0,16,0"
                                  VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <Path Style="{StaticResource ProviderGlyph}" Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ChartTitle}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <!-- What the dashed lines are, only while comparing. It sits
                             under the title so it never squeezes it at narrow widths. -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding ComparisonLabel, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                            <Line X1="0" X2="18" Y1="0" Y2="0" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                                  StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,1,6,0" />
                            <TextBlock Text="{Binding ComparisonLabel}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <controls:UsageChart x:Name="MainChart" Grid.Row="1" Height="260" Style="{StaticResource ThemedUsageChart}"
                                     Data="{Binding Chart}" />
            </Grid>
        </Grid>

        <!-- 4. The five headline tiles -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Margin="0,0,-10,22" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Caption}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Footnote}" FontSize="11" Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                            <TextBlock Text="{Binding DeltaText}" Style="{StaticResource DeltaText}" Margin="0,4,0,0"
                                       HorizontalAlignment="Left" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 5. Breakdown -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="Breakdown" Content="MODEL"
                                     IsChecked="{Binding BreakdownIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Breakdown" Content="{Binding TimeBreakdownLabel}"
                                     IsChecked="{Binding BreakdownIndex, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding BreakdownHint}" DockPanel.Dock="Right" FontSize="11" Margin="0,0,14,0"
                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"
                           Visibility="{Binding BreakdownHint, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                <TextBlock Text="Breakdown" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Column widths are shared with the rows below. While comparing, the
                 model view shows both periods side by side (A, B) and the change;
                 Share makes room for them. -->
            <Grid Grid.Row="1" Margin="0,0,14,0" Height="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SortHeader}" HorizontalAlignment="Left"
                        Command="{Binding SortCommand}" CommandParameter="Label"
                        AutomationProperties.Name="{Binding BreakdownColumnHeader, StringFormat='Sort by {0}'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding BreakdownColumnHeader}" />
                        <TextBlock Text="{Binding LabelSortGlyph}" FontSize="8" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SortHeader}"
                        Command="{Binding SortCommand}" CommandParameter="Value"
                        AutomationProperties.Name="{Binding BreakdownValueHeader, StringFormat='Sort by {0}'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ValueSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BreakdownValueHeader}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource SortHeader}" Width="130"
                        Command="{Binding SortCommand}" CommandParameter="PreviousValue" AutomationProperties.Name="Sort by API value B"
                        Visibility="{Binding ShowComparisonColumns, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PreviousValueSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="API value B" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource SortHeader}" Width="110"
                        Command="{Binding SortCommand}" CommandParameter="Share" AutomationProperties.Name="Sort by share"
                        Visibility="{Binding ShowComparisonColumns, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ShareSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Share" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource SortHeader}"
                        Command="{Binding SortCommand}" CommandParameter="Tokens"
                        AutomationProperties.Name="{Binding BreakdownTokensHeader, StringFormat='Sort by {0}'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TokensSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BreakdownTokensHeader}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource SortHeader}" Width="110"
                        Command="{Binding SortCommand}" CommandParameter="PreviousTokens" AutomationProperties.Name="Sort by tokens B"
                        Visibility="{Binding ShowComparisonColumns, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PreviousTokensSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tokens B" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource SortHeader}" Width="120"
                        Command="{Binding SortCommand}" CommandParameter="Change" AutomationProperties.Name="Sort by change"
                        ToolTip="Change in API value from the earlier period to the later one, as an average per day when the periods differ in length. Models without a price, or periods with unpriced usage, compare tokens instead."
                        Visibility="{Binding ShowComparisonColumns, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ChangeSortGlyph}" FontSize="8" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ChangeHeader}" />
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,4,0">
                <ItemsControl ItemsSource="{Binding BreakdownRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                                <Button Style="{StaticResource BreakdownRow}"
                                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid Margin="0,9,10,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Path Style="{StaticResource RowGlyph}" />
                                            <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource TableCell}" Text="{Binding ValueText}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource TableCell}" Width="130" TextAlignment="Right"
                                                   Text="{Binding PreviousValueText}" Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding DataContext.ShowComparisonColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource TableCell}" Width="110" TextAlignment="Right"
                                                   Text="{Binding ShareText}"
                                                   Visibility="{Binding DataContext.ShowComparisonColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource TableCell}" Text="{Binding TokensText}" />
                                        <TextBlock Grid.Column="5" Style="{StaticResource TableCell}" Width="110" TextAlignment="Right"
                                                   Text="{Binding PreviousTokensText}" Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding DataContext.ShowComparisonColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                        <TextBlock Grid.Column="6" Style="{StaticResource TableCell}" Width="120"
                                                   TextAlignment="Right" Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding ChangeText}"
                                                   Visibility="{Binding DataContext.ShowComparisonColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Empty / loading / error state, over the whole body -->
        <Border Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource WidgetBgBrush}"
                Visibility="{Binding HasData, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
            <TextBlock Text="{Binding StatusText}" FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" LineHeight="20" />
        </Border>
        </Grid>

        <!-- 6. Model details, over the body. The title bar stays live, so the
             window can still be moved and closed; Escape, the close button and
             a click on the dimmed area dismiss the panel. -->
        <Grid x:Name="ModelDetailOverlay" Grid.Row="1"
              Visibility="{Binding IsModelDetailOpen, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Border Background="{DynamicResource ScrimBrush}" MouseLeftButtonDown="OnModelScrimMouseDown" />
            <Border x:Name="ModelDetailCard" DataContext="{Binding ModelDetail}"
                    Width="840" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="1" CornerRadius="14"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    AutomationProperties.Name="{Binding Model, StringFormat='Details for {0}'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Margin="26,22,26,24">
                        <DockPanel>
                            <Button x:Name="ModelDetailCloseButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                    Style="{StaticResource IconButton}" BorderThickness="0"
                                    Command="{Binding DataContext.CloseModelDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="Close" AutomationProperties.Name="Close details">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.3" Width="10" Height="10" />
                            </Button>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ProviderGlyph}" Width="20" Height="20" Margin="0,2,10,0" />
                                    <TextBlock Text="{Binding Model}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,22,0,0">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource DetailCaption}" Text="API value" />
                                <TextBlock Style="{StaticResource DetailFigure}" Text="{Binding CostText}" />
                                <TextBlock Style="{StaticResource DeltaText}" Text="{Binding CostDeltaText}" Margin="0,3,0,0"
                                           HorizontalAlignment="Left" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource DetailCaption}" Text="Tokens" />
                                <TextBlock Style="{StaticResource DetailFigure}" Text="{Binding TokensText}" />
                                <TextBlock Style="{StaticResource DeltaText}" Text="{Binding TokensDeltaText}" Margin="0,3,0,0"
                                           HorizontalAlignment="Left" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource DetailCaption}" Text="Per 1M tokens" />
                                <TextBlock Style="{StaticResource DetailFigure}" Text="{Binding PerMillionText}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailCaption}" Text="Cache hit" />
                                <TextBlock Style="{StaticResource DetailFigure}" Text="{Binding CacheHitText}" />
                            </StackPanel>
                        </UniformGrid>

                        <DockPanel Margin="0,22,0,8">
                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}"
                                    Visibility="{Binding IsPriced, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DetailMetric" Content="API VALUE"
                                                 IsChecked="{Binding DataContext.MetricIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=0}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="DetailMetric" Content="TOKENS"
                                                 IsChecked="{Binding DataContext.MetricIndex, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, Converter={x:Static local:IndexToBoolConverter.Instance}, ConverterParameter=1}" />
                                </StackPanel>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DetailSectionTitle}" Text="{Binding ChartTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                            Visibility="{Binding DataContext.ComparisonLabel, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:StringToVisibilityConverter.Instance}}">
                                    <Line X1="0" X2="18" Y1="0" Y2="0" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4"
                                          StrokeDashArray="3 2" VerticalAlignment="Center" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding DataContext.ComparisonLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <!-- Which way the B figures above change, as in the table. -->
                                    <TextBlock Text="{Binding DataContext.ChangeHeader, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='· {0}'}"
                                               FontSize="11.5" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Average per day, partial today, missing history: the
                                     same caveats the header gives, where the figures are. -->
                                <TextBlock Text="{Binding DataContext.ComparisonNote, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           Visibility="{Binding DataContext.ComparisonNote, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </DockPanel>

                        <controls:UsageChart x:Name="ModelChart" Height="220" Style="{StaticResource ThemedUsageChart}"
                                             Data="{Binding Chart}" />

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource DetailSectionTitle}" Text="API value by type" />
                                <StackPanel Visibility="{Binding IsPriced, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                    <controls:UsageSplitBar Style="{StaticResource ModelSplitBar}" Values="{Binding CostSplit}" />
                                    <ItemsControl ItemsSource="{Binding CostLegend}" Focusable="False"
                                                  ItemsPanel="{StaticResource WrapItems}"
                                                  ItemTemplate="{StaticResource SplitLegendItem}" />
                                </StackPanel>
                                <TextBlock Text="This model has no known price, so its value cannot be split."
                                           FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           Visibility="{Binding IsPriced, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DetailSectionTitle}" Text="Tokens by type" />
                                <controls:UsageSplitBar Style="{StaticResource ModelSplitBar}" Values="{Binding TokenSplit}" />
                                <ItemsControl ItemsSource="{Binding TokenLegend}" Focusable="False"
                                              ItemsPanel="{StaticResource WrapItems}"
                                              ItemTemplate="{StaticResource SplitLegendItem}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
