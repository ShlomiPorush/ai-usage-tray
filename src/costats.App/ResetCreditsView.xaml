<UserControl x:Class="costats.App.ResetCreditsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <Button Content="&#x2190;" DockPanel.Dock="Left" VerticalAlignment="Top" Click="OnBackClick"
                        Width="30" Height="30" Padding="0" Margin="0,0,10,0" FontSize="15"
                        IsEnabled="{Binding CanInteract}" ToolTip="Back to account" AutomationProperties.Name="Back to account" />
                <StackPanel>
                    <TextBlock Text="Usage resets" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding AccountName}" Margin="0,3,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,16,0,12" TextWrapping="Wrap"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <ListBox x:Name="CreditsList" Grid.Row="2" ItemsSource="{Binding Credits}" SelectedItem="{Binding SelectedCredit}"
                     IsEnabled="{Binding CanInteract}" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" AutomationProperties.Name="Available resets">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Background="Transparent" Padding="{TemplateBinding Padding}" Focusable="False"
                                      CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" CornerRadius="10" Padding="10"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            Background="{DynamicResource ButtonBgBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource KindBadgeBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,5,0,10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ExpiryText}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding GrantedText}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFaintBrush}" />
                            <TextBlock Text="{Binding AvailabilityText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{Binding Status}" Margin="0,8,0,8" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
            <Border Grid.Row="4" Padding="12" Margin="0,0,0,12" CornerRadius="8"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ScrollViewer MaxHeight="125" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Cancel" Command="{Binding CancelReviewCommand}" Margin="0,0,8,0" />
                        <Button Content="Confirm use" Command="{Binding ConfirmCommand}" FontWeight="SemiBold"
                                Background="{DynamicResource KindBadgeBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="5">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Left" />
                <Button Content="Use selected reset" Command="{Binding ReviewCommand}" HorizontalAlignment="Right"
                        FontWeight="SemiBold" Background="{DynamicResource KindBadgeBrush}" />
            </DockPanel>
        </Grid>
</UserControl>
