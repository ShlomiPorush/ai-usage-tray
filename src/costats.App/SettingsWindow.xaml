<Window x:Class="costats.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        Title="Settings"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="16"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>


        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- CheckBox Style -->
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="4"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L7,11 L13,3" Stroke="White" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="12" Height="10" Stretch="Uniform" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource PanelBgBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                <Button Content="X" Click="OnCloseClick" DockPanel.Dock="Right"
                        HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                        Style="{StaticResource SettingsButton}" FontWeight="SemiBold" />
            </DockPanel>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

            <!-- Settings Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="640">
            <StackPanel>

                <!-- System Section -->
                <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <CheckBox IsChecked="{Binding StartAtLogin}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,6">
                    <TextBlock Text="Start at login" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>
                <TextBlock Text="Automatically launch AI Usage Tray when Windows starts."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="30,0,0,12" />

                <CheckBox IsChecked="{Binding ShowOverviewResetTimes}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,6">
                    <TextBlock Text="Show reset times in overview" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>
                <TextBlock Text="Adds each window's reset countdown to the account cards on the widget's main screen."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="30,0,0,12" TextWrapping="Wrap" />

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Theme" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme}"
                              DockPanel.Dock="Right" HorizontalAlignment="Right" Width="140" />
                </DockPanel>
                <TextBlock Text="Follow system tracks the Windows app theme; Light and Dark are fixed."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                <!-- Automation Section -->
                <TextBlock Text="AUTOMATION" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Refresh interval" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding RefreshOptions}"
                              SelectedItem="{Binding SelectedRefreshOption}"
                              DockPanel.Dock="Right" HorizontalAlignment="Right" Width="120" />
                </DockPanel>
                <TextBlock Text="How often AI Usage Tray polls for usage data in the background."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,0" />

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,16" />

                <!-- Monitored accounts -->
                <TextBlock Text="ACCOUNTS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />
                <TextBlock Text="Each account points at the local profile folder its login lives in (CLAUDE_CONFIG_DIR for Claude, CODEX_HOME for Codex). Sign in with the official CLI inside that folder; this app never stores provider passwords."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding ProviderRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                <DockPanel>
                                    <Button Content="&#x2715;" DockPanel.Dock="Right" Width="26" Height="24" Padding="0"
                                            FontSize="10" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveProviderRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SettingsButton}" Margin="6,0,0,0" />
                                    <Button Content="Edit" DockPanel.Dock="Right" Height="24" Padding="8,0"
                                            FontSize="10" Click="OnEditRowClick"
                                            Style="{StaticResource SettingsButton}" />
                                    <Button Content="{Binding PrimaryGlyph}" DockPanel.Dock="Right" Width="26" Height="24" Padding="0"
                                            FontSize="12" ToolTip="Primary account: its status drives the tray icon and it is pinned to the top of the overview"
                                            Command="{Binding DataContext.SetPrimaryRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SettingsButton}" Margin="0,0,6,0" />
                                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                            Background="{DynamicResource KindBadgeBrush}" Margin="0,0,8,0" Width="54">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="9.5" FontFamily="Consolas"
                                                   Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+ Add account" Click="OnAddAccountClick"
                        Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,4,0,0" />

                <TextBlock Text="{Binding AccountsRestartMessage}" FontSize="11" Foreground="#F97316" Margin="0,8,0,0"
                           Visibility="{Binding AccountsRestartMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,16" />

                <!-- Remote View Section -->
                <TextBlock Text="REMOTE VIEW" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <CheckBox IsChecked="{Binding RemoteViewEnabled}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,6">
                    <TextBlock Text="Enable remote view" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                </CheckBox>
                <TextBlock Text="After each refresh, uploads a small snapshot to your endpoint: provider, account nickname, plan, usage percentages and reset times. No tokens, credentials or folder paths are sent. The snapshot expires server-side after about a week without updates."
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="30,0,0,12" TextWrapping="Wrap" />

                <TextBlock Text="Upload endpoint URL" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding RemoteViewUploadUrl, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource SettingsTextBox}" Margin="0,0,0,4" />
                <TextBlock Text="Base URL of the worker that stores the snapshot, e.g. https://usage-api.example.com"
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                <TextBlock Text="Viewer page URL" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding RemoteViewPageUrl, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource SettingsTextBox}" Margin="0,0,0,4" />
                <TextBlock Text="Base URL of the page you open on your phone, e.g. https://usage.example.com"
                           FontSize="11" Foreground="{DynamicResource TextFaintBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                <DockPanel Margin="0,0,0,6">
                    <Button Content="Copy link" Command="{Binding CopyShareLinkCommand}"
                            Style="{StaticResource SettingsButton}" Padding="10,5" FontSize="11"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ShareLink, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource SettingsTextBox}" FontSize="11"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock Text="Anyone with the link can view this data."
                           FontSize="11" Foreground="#EF4444" Margin="0,0,0,0" TextWrapping="Wrap" />

                <!-- Divider -->
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,16,0,16" />

                <!-- Updates Section -->
                <TextBlock Text="UPDATES" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,12" />

                <DockPanel>
                    <Button Content="Check for updates"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingForUpdates, Converter={x:Static local:BoolNegationConverter.Instance}}"
                            Style="{StaticResource SettingsButton}"
                            DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding UpdateStatusText}"
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding UpdateStatusText, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                </DockPanel>

            </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />
                <DockPanel>
                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                    <Button Content="Restart app" Command="{Binding RestartAppCommand}"
                            ToolTip="Restart AI Usage Tray"
                            Style="{StaticResource SettingsButton}" Padding="10,5" FontSize="11"
                            DockPanel.Dock="Left" HorizontalAlignment="Left" />
                    <TextBlock Text="Changes are saved automatically."
                               FontSize="11" Foreground="{DynamicResource TextFaintBrush}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
