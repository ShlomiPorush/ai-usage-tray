<Window x:Class="costats.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:costats.App"
        Title="Settings"
        Width="920"
        Height="660"
        SizeToContent="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      CornerRadius="16"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="210" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Square check box, used inside account lists. -->
        <Style x:Key="SettingsCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="CheckBorder" Width="20" Height="20" CornerRadius="5"
                                    Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource TextFaintBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M3,7 L7,11 L13,3" Stroke="White" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="12" Height="10" Stretch="Uniform" />
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting row: the label and description are the CheckBox content on
             the left and the switch is drawn on the right, so the whole row is
             one click and keyboard target and keeps its accessible content. -->
        <Style x:Key="SettingsToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" CornerRadius="12"
                                    Background="Transparent" BorderBrush="{DynamicResource TextFaintBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{DynamicResource TextMutedBrush}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource PanelBgBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="CardDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Margin" Value="-18,15,-18,15" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <Style x:Key="SettingWarning" TargetType="TextBlock" BasedOn="{StaticResource SettingDescription}">
            <Setter Property="Foreground" Value="#F97316" />
        </Style>

        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>

        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SettingsNavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNavigation" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" CornerRadius="2" Margin="-12,2,0,2"
                                        HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                <Setter TargetName="ItemBorder" Property="Padding" Value="11,9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SettingsPage" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1"
            Background="{DynamicResource PanelBgBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource WidgetBgBrush}" CornerRadius="15,0,0,15"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,24,14,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="10,0,10,20">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="AI Usage Tray" FontSize="12.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel x:Name="NavigationList"
                                    KeyboardNavigation.TabNavigation="Once"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                            <RadioButton x:Name="GeneralNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.General}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="General">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M2,3 H15 M5,1 V5 M2,9 H15 M11,7 V11 M2,15 H15 M7,13 V17" />
                                    <TextBlock Text="General" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AutomationNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.Automation}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Automation">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M9,1 A8,8 0 1 0 9,17 A8,8 0 1 0 9,1 M9,5 V9 L12,11" />
                                    <TextBlock Text="Automation" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DisplayNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.Display}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Display">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M1,9 C4,3 13,3 16,9 C13,15 4,15 1,9 Z M6,9 A3,3 0 1 0 12,9 A3,3 0 1 0 6,9" />
                                    <TextBlock Text="Display" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AlertsNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.Alerts}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Alerts">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M4,7 A5,5 0 0 1 14,7 V11 L16,14 H2 L4,11 Z M7,16 H11" />
                                    <TextBlock Text="Alerts" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="AccountsNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.Accounts}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Accounts">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProviderRows.Count}" FontSize="12"
                                               FontWeight="Normal" Foreground="{DynamicResource TextFaintBrush}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource NavIcon}" Data="M6,8 A3,3 0 1 0 6,2 A3,3 0 1 0 6,8 M1,16 V14 C1,11 3,10 6,10 C9,10 11,11 11,14 V16 M13,7 A2.5,2.5 0 1 0 13,2 M12,10 C15,10 17,11 17,14 V16" />
                                        <TextBlock Text="Accounts" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </RadioButton>
                            <RadioButton x:Name="RemoteViewNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.RemoteView}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Remote view">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M9,1 A8,8 0 1 0 9,17 A8,8 0 1 0 9,1 M1,9 H17 M9,1 C6,5 6,13 9,17 M9,1 C12,5 12,13 9,17" />
                                    <TextBlock Text="Remote view" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="UpdatesNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.Updates}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Updates">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M16,5 V1 L12,5 H16 C17,7 17,10 16,12 C14,16 9,18 5,16 M2,13 V17 L6,13 H2 C1,11 1,8 2,6 C4,2 9,0 13,2" />
                                    <TextBlock Text="Updates" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LocalUsageDataNavItem" Style="{StaticResource SettingsNavItem}"
                                         Tag="{x:Static local:SettingsCategory.LocalUsageData}" Checked="OnNavItemChecked"
                                         AutomationProperties.Name="Local usage data">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource NavIcon}" Data="M1,4 C1,1 17,1 17,4 V14 C17,17 1,17 1,14 Z M1,4 C1,7 17,7 17,4 M1,9 C1,12 17,12 17,9" />
                                    <TextBlock Text="Local usage data" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Always visible, whichever page is open: version, update
                         feedback, and the two maintenance actions. -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />
                        <StackPanel Margin="10,0,10,10">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                       FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       FontSize="12" Foreground="{DynamicResource TextFaintBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"
                                       ToolTip="{Binding UpdateStatusText}"
                                       Visibility="{Binding UpdateStatusText, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                            <ProgressBar Height="5" Minimum="0" Maximum="100"
                                         Value="{Binding UpdateProgressPercent}"
                                         IsIndeterminate="{Binding IsUpdateProgressIndeterminate}"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource InputBgBrush}"
                                         BorderThickness="0" Margin="0,8,0,0"
                                         Visibility="{Binding IsUpdateProgressVisible, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                        <Button Content="Check for updates"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding IsUpdateBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                Style="{StaticResource SettingsButton}" Margin="0,0,0,8" />
                        <Button Content="Restart app" Command="{Binding RestartAppCommand}"
                                ToolTip="Restart AI Usage Tray"
                                Style="{StaticResource SettingsButton}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="32,26,22,18">
                    <Button Content="&#x2715;" Click="OnCloseClick" DockPanel.Dock="Right" VerticalAlignment="Top"
                            Width="34" Height="34" Padding="0" FontSize="13"
                            ToolTip="Close" AutomationProperties.Name="Close"
                            Style="{StaticResource SettingsButton}" BorderThickness="0" Background="Transparent" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PageDescription" FontSize="13.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </DockPanel>

                <!-- The app-wide slim auto-hide ScrollBar style (Themes/Controls.xaml)
                     draws the bar in the right margin, clear of the cards. -->
                <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="32,0,22,28" Margin="0,0,6,0">
                    <Grid>

                        <!-- General -->
                        <StackPanel x:Name="GeneralPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding StartAtLogin}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Start at login">
                                    <StackPanel>
                                        <TextBlock Text="Start at login" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Automatically launch AI Usage Tray when Windows starts."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Refresh interval" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="How often AI Usage Tray polls for usage data in the background."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}"
                                              SelectedItem="{Binding SelectedRefreshOption}"
                                              AutomationProperties.Name="Refresh interval" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding HotkeyEnabled}" Style="{StaticResource SettingsToggle}"
                                              AutomationProperties.Name="Enable global shortcut">
                                        <StackPanel>
                                            <TextBlock Text="Enable global shortcut" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Use a modifier and one key, for example Ctrl+Alt+U."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Style="{StaticResource CardDivider}" />
                                    <Grid IsEnabled="{Binding HotkeyEnabled}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shortcut" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Hotkey, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource SettingsTextBox}" Width="210"
                                                 AutomationProperties.Name="Shortcut" />
                                    </Grid>
                                    <TextBlock Text="{Binding HotkeyStatus}" Style="{StaticResource SettingWarning}" Margin="0,8,0,0"
                                               Visibility="{Binding HotkeyStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Move to another computer" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Moves your accounts and preferences to another computer. API keys, tokens and the remote view link are not included. Sign in to Claude and Codex again on the new computer."
                                               Style="{StaticResource SettingDescription}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal"
                                                IsEnabled="{Binding IsSettingsTransferBusy, Converter={x:Static local:BoolNegationConverter.Instance}}">
                                        <Button Content="Export settings" Click="OnExportSettingsClick"
                                                Style="{StaticResource SettingsButton}" />
                                        <Button Content="Import settings" Click="OnImportSettingsClick"
                                                Style="{StaticResource SettingsButton}" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <Border x:Name="ImportConfirmationPanel" CornerRadius="8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            Background="{DynamicResource PanelBgBrush}" Padding="14" Margin="0,12,0,0"
                                            Visibility="{Binding IsImportConfirmationVisible, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock Text="Replace current settings?" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding ImportConfirmationText}" FontSize="12.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding CancelImportCommand}"
                                                        Style="{StaticResource SettingsButton}" />
                                                <Button Content="Import and replace" Command="{Binding ConfirmImportCommand}"
                                                        Style="{StaticResource SettingsButton}" Margin="8,0,0,0"
                                                        BorderBrush="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="SettingsTransferResult" Text="{Binding SettingsTransferMessage}" FontSize="12.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SettingsTransferMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Troubleshooting" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding DebugLoggingEnabled}" Style="{StaticResource SettingsToggle}"
                                              AutomationProperties.Name="Debug logging">
                                        <StackPanel>
                                            <TextBlock Text="Debug logging" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Records everything the app does in a separate log to help find problems. Turns off by itself after 7 days, and the log is deleted when it turns off."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <DockPanel Margin="0,14,0,0">
                                        <!-- Dimmed by the button style while debug logging is off and there is no folder to open. -->
                                        <Button Content="Open log folder" Command="{Binding OpenDebugLogFolderCommand}"
                                                Style="{StaticResource SettingsButton}" DockPanel.Dock="Left" />
                                        <TextBlock Text="{Binding DebugLoggingStatus}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Visibility="{Binding DebugLoggingStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Automation -->
                        <StackPanel x:Name="AutomationPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SessionActivationScheduleEnabled}" Style="{StaticResource SettingsToggle}"
                                              AutomationProperties.Name="Limit automatic starts to a daily schedule">
                                        <StackPanel>
                                            <TextBlock Text="Limit automatic starts to a daily schedule" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Outside these hours, expired windows wait. If this PC wakes during the schedule, they start immediately."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <StackPanel Visibility="{Binding SessionActivationScheduleEnabled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Border Style="{StaticResource CardDivider}" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start at" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding SessionActivationHourOptions}"
                                                      SelectedItem="{Binding SelectedSessionActivationScheduleStart}"
                                                      AutomationProperties.Name="Start at" />
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stop starting at" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding SessionActivationHourOptions}"
                                                      SelectedItem="{Binding SelectedSessionActivationScheduleEnd}"
                                                      AutomationProperties.Name="Stop starting at" />
                                        </Grid>
                                        <TextBlock Text="{Binding SessionActivationScheduleDescription}" Style="{StaticResource SettingDescription}" />
                                        <TextBlock Text="Choose different start and stop times. Automatic starts are paused until the schedule is valid."
                                                   Style="{StaticResource SettingDescription}" Foreground="{DynamicResource SessionAccent}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasInvalidSessionActivationSchedule, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding AutoStartClaudeFiveHourWindow}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Automatically start new Claude 5-hour windows">
                                    <StackPanel>
                                        <TextBlock Text="Automatically start new Claude 5-hour windows" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="After an observed window expires, starts the next one with a minimal Claude Code prompt."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding AutoStartCodexFiveHourWindow}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Automatically start new Codex 5-hour windows">
                                    <StackPanel>
                                        <TextBlock Text="Automatically start new Codex 5-hour windows" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="When an account is idle, starts a window with an isolated read-only Codex prompt, then starts the next one after expiry."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding AutoStartZaiFiveHourWindow}"
                                          IsEnabled="{Binding CanAutoStartZaiFiveHourWindow}"
                                          Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Automatically start new GLM 5-hour windows">
                                    <StackPanel>
                                        <TextBlock Text="Automatically start new GLM 5-hour windows" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="When the account is idle, starts a window with a minimal GLM prompt, then starts the next one after expiry. Requires the coding-plan key."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <!-- Display -->
                        <StackPanel x:Name="DisplayPage" Style="{StaticResource SettingsPage}">
                            <TextBlock Text="Appearance" Style="{StaticResource GroupHeader}" Margin="2,0,0,8" />
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Follow system tracks the Windows app theme; Light and Dark are fixed."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                              AutomationProperties.Name="Theme" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="Dark style" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="The colours used whenever the theme is dark."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DarkPaletteOptions}" SelectedItem="{Binding SelectedDarkPalette}"
                                              AutomationProperties.Name="Dark style" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Numbers" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding ShowRemainingPercentages}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Show remaining percentages instead of used">
                                    <StackPanel>
                                        <TextBlock Text="Show remaining percentages instead of used" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Applies to numbers and bars in the tray, panels, and main window. Colours stay green for available capacity and red near exhaustion."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding ShowOverviewResetTimes}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Show Resets in times on the main page">
                                    <StackPanel>
                                        <TextBlock Text="Show &quot;Resets in...&quot; times on the main page" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Adds the reset countdown next to each usage bar in the account overview."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding ShowWeeklyBeforeSession}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Show Weekly before Session in tray panels">
                                    <StackPanel>
                                        <TextBlock Text="Show Weekly before Session in tray panels" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Enabled by default for the tray hover and floating status panel. Turn it off to restore Session before Weekly."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <TextBlock Text="Floating panel" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ShowFloatingStatusPanel}" Style="{StaticResource SettingsToggle}"
                                              AutomationProperties.Name="Show the floating status panel">
                                        <StackPanel>
                                            <TextBlock Text="Show the floating status panel" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Drag to move; drag an edge or corner to resize. Providers flow into columns as you widen the panel. Your size is saved. Use X to close it."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                    </CheckBox>

                                    <StackPanel Visibility="{Binding ShowFloatingStatusPanel, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <Border Style="{StaticResource CardDivider}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,20,0">
                                                <TextBlock Text="Starting position" Style="{StaticResource SettingLabel}" />
                                                <TextBlock Text="The panel stays anchored here when its size changes. Dragging moves it for the current app session."
                                                           Style="{StaticResource SettingDescription}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding FloatingPanelPositionOptions}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding FloatingPanelPosition, Mode=TwoWay}"
                                                      AutomationProperties.Name="Starting position" />
                                        </Grid>
                                        <Border Style="{StaticResource CardDivider}" />
                                        <TextBlock Text="Accounts shown" Style="{StaticResource SettingLabel}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding ProviderRows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsShownInFloatingPanel, Mode=OneWay}"
                                                              IsEnabled="{Binding CanChangeFloatingPanelSelection}"
                                                              Command="{Binding DataContext.ToggleFloatingPanelAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" Style="{StaticResource SettingsCheckBox}" Margin="0,0,0,8"
                                                              AutomationProperties.Name="{Binding Name}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding KindLabel, StringFormat='  {0}'}" FontSize="12.5"
                                                                       Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="New accounts are shown automatically. At least one account must remain selected."
                                                   Style="{StaticResource SettingDescription}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Alerts -->
                        <StackPanel x:Name="AlertsPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding UsageAlertsEnabled}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Enable usage alerts">
                                    <StackPanel>
                                        <TextBlock Text="Enable usage alerts" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Shows a notification once when a selected account window crosses its threshold. Each window rearms after it drops below the threshold or resets."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding UsageResetAlertsEnabled}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Notify when weekly usage resets to 0%">
                                    <StackPanel>
                                        <TextBlock Text="Notify when weekly usage resets to 0%" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Uses the same selected accounts. The notification appears only when a weekly window changes from above 0% used to exactly 0%."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Button Content="Test notification" Command="{Binding TestNotificationCommand}"
                                    Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                            <StackPanel Visibility="{Binding UsageAlertsEnabled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Accounts notified" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding ProviderRows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding UsageAlertsEnabled, Mode=OneWay}"
                                                                  Command="{Binding DataContext.ToggleUsageAlertAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" Style="{StaticResource SettingsCheckBox}"
                                                                  AutomationProperties.Name="{Binding Name}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding KindLabel, StringFormat='  {0}'}" FontSize="12.5"
                                                                           Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    IsEnabled="{Binding UsageAlertsEnabled}" Margin="12,0,0,0">
                                                            <TextBlock Text="Alert at" FontSize="12.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaintBrush}" />
                                                            <TextBox Text="{Binding UsageAlertThreshold, Mode=OneWay}"
                                                                     LostFocus="OnUsageAlertThresholdLostFocus"
                                                                     Style="{StaticResource SettingsTextBox}" Width="58" MaxLength="3"
                                                                     Padding="8,5" HorizontalContentAlignment="Right"
                                                                     AutomationProperties.Name="Alert threshold percent" />
                                                            <TextBlock Text="%" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="New accounts start with alerts off and a 90% threshold. The threshold is applied independently to every quota window on that account."
                                                   Style="{StaticResource SettingDescription}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Accounts -->
                        <StackPanel x:Name="AccountsPage" Style="{StaticResource SettingsPage}">
                            <TextBlock Text="Each account points at the local profile folder its login lives in (CLAUDE_CONFIG_DIR for Claude, CODEX_HOME for Codex). Sign in with the official CLI inside that folder; this app never stores provider passwords."
                                       Style="{StaticResource SettingDescription}" Margin="2,0,0,6" />
                            <TextBlock Text="Keep session active is optional and off by default. For Claude and Codex it periodically asks the provider's official client to refresh the account session before it expires. It does not start an agent session or spend quota."
                                       Style="{StaticResource SettingDescription}" Margin="2,0,0,14" />

                            <ItemsControl ItemsSource="{Binding ProviderRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Identity on the first row, actions on their own row, so the name
                                             and folder keep the full card width even when the window is narrow. -->
                                        <Border Style="{StaticResource SettingsCard}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" CornerRadius="6" Padding="6,4" VerticalAlignment="Center"
                                                            Background="{DynamicResource KindBadgeBrush}" Margin="0,0,14,0" Width="88">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" FontFamily="Consolas" Margin="0,2,0,0"
                                                                   Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding KeepSessionActive, Mode=OneWay}"
                                                              Command="{Binding DataContext.ToggleKeepSessionActiveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"
                                                              Style="{StaticResource SettingsToggle}" VerticalAlignment="Center"
                                                              Visibility="{Binding CanKeepSessionActive, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                              ToolTip="Periodically refresh this account session through the provider's official client"
                                                              AutomationProperties.Name="Keep active">
                                                        <TextBlock Text="Keep active" FontSize="13"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </CheckBox>
                                                    <Button Content="&#x2715;" DockPanel.Dock="Right" Width="34" Height="32" Padding="0"
                                                            ToolTip="Remove" AutomationProperties.Name="Remove"
                                                            Command="{Binding DataContext.RemoveProviderRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SettingsButton}" Margin="6,0,0,0" />
                                                    <Button Content="Edit" DockPanel.Dock="Right" Height="32" Padding="12,0"
                                                            Click="OnEditRowClick"
                                                            Style="{StaticResource SettingsButton}" />
                                                    <Button Content="Relogin" DockPanel.Dock="Right" Height="32" Padding="12,0"
                                                            ToolTip="Sign in again with this account's official CLI"
                                                            Command="{Binding DataContext.ReloginProviderRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SettingsButton}" Margin="0,0,6,0"
                                                            Visibility="{Binding CanRelogin, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                                    <Button Content="{Binding PrimaryGlyph}" DockPanel.Dock="Right" Width="34" Height="32" Padding="0"
                                                            FontSize="14" ToolTip="Primary account: its status drives the tray icon and it is pinned to the top of the overview"
                                                            AutomationProperties.Name="Primary account"
                                                            Command="{Binding DataContext.SetPrimaryRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SettingsButton}" Margin="0,0,6,0" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="+ Add account" Click="OnAddAccountClick"
                                    Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />

                            <TextBlock Text="{Binding AccountsRestartMessage}" Style="{StaticResource SettingWarning}" Margin="0,10,0,0"
                                       Visibility="{Binding AccountsRestartMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <!-- Remote view -->
                        <StackPanel x:Name="RemoteViewPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding RemoteViewEnabled}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Enable remote view">
                                    <StackPanel>
                                        <TextBlock Text="Enable remote view" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="{Binding RemoteViewHint}" Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <!-- Usage sharing rides on the remote view, so it is only available while that is on. -->
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding RemoteViewShareUsage}" IsEnabled="{Binding RemoteViewEnabled}"
                                              Style="{StaticResource SettingsToggle}"
                                              AutomationProperties.Name="Share usage on the remote view">
                                        <StackPanel>
                                            <TextBlock Text="Share usage on the remote view" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Adds a Usage tab to the remote view with the cost and token report of the Usage window."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding RemoteUsageStatus}" Style="{StaticResource SettingWarning}" Margin="0,8,0,0"
                                               Visibility="{Binding RemoteUsageStatus, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                                </StackPanel>
                            </Border>

                            <!-- Endpoint boxes only appear when this build ships no default service. -->
                            <StackPanel Visibility="{Binding ShowRemoteViewUrlFields, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Server" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <TextBlock Text="Upload endpoint URL" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Base URL of the server that stores the snapshot, e.g. https://usage-api.example.com. Must be https."
                                                   Style="{StaticResource SettingDescription}" />
                                        <TextBox Text="{Binding RemoteViewUploadUrl, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource SettingsTextBox}" Margin="0,10,0,0"
                                                 AutomationProperties.Name="Upload endpoint URL" />
                                        <Border Style="{StaticResource CardDivider}" />
                                        <TextBlock Text="Viewer page URL" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Base URL of the page you open on your phone, e.g. https://usage.example.com. Must be https."
                                                   Style="{StaticResource SettingDescription}" />
                                        <TextBox Text="{Binding RemoteViewPageUrl, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource SettingsTextBox}" Margin="0,10,0,0"
                                                 AutomationProperties.Name="Viewer page URL" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- The link and its warning only make sense while remote view is on. -->
                            <StackPanel Visibility="{Binding RemoteViewEnabled, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="Share link" Style="{StaticResource GroupHeader}" />
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button Content="Copy link" Command="{Binding CopyShareLinkCommand}"
                                                    Style="{StaticResource SettingsButton}"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0" />
                                            <Button Content="New link" Command="{Binding NewRemoteViewLinkCommand}"
                                                    ToolTip="Create a fresh link and retire the current one"
                                                    Style="{StaticResource SettingsButton}"
                                                    DockPanel.Dock="Right" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding ShareLink, Mode=OneWay}" IsReadOnly="True"
                                                     Style="{StaticResource SettingsTextBox}" FontSize="12.5"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Share link" />
                                        </DockPanel>
                                        <TextBlock Text="Anyone with the link can view this data. Only this app can update it."
                                                   Style="{StaticResource SettingDescription}" Foreground="#EF4444" Margin="0,10,0,0" />
                                        <TextBlock Text="New link: the old link stops updating at once and stops working within a week."
                                                   Style="{StaticResource SettingDescription}" />
                                        <Border Style="{StaticResource CardDivider}" />
                                        <Button Content="Generate QR" Command="{Binding GenerateRemoteViewQrCodeCommand}"
                                                ToolTip="Create a QR code for the read-only phone view"
                                                Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" />
                                        <Border Background="White" CornerRadius="8" Padding="10" HorizontalAlignment="Left"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding HasRemoteViewQrCode, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                            <StackPanel>
                                                <Image Source="{Binding RemoteViewQrImage}" Width="220" Height="220"
                                                       Stretch="Uniform" SnapsToDevicePixels="True" />
                                                <TextBlock Text="Scan to open the read-only phone view"
                                                           Foreground="#222222" FontSize="12" HorizontalAlignment="Center"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding RemoteViewMessage}" Style="{StaticResource SettingWarning}" Margin="0,10,0,0"
                                       Visibility="{Binding RemoteViewMessage, Converter={x:Static local:StringToVisibilityConverter.Instance}}" />
                        </StackPanel>

                        <!-- Updates -->
                        <StackPanel x:Name="UpdatesPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <CheckBox IsChecked="{Binding AutomaticUpdateChecksEnabled}" Style="{StaticResource SettingsToggle}"
                                          AutomationProperties.Name="Check for updates automatically">
                                    <StackPanel>
                                        <TextBlock Text="Check for updates automatically" Style="{StaticResource SettingLabel}" />
                                        <TextBlock Text="Runs a background GitHub check every six hours. Manual checks always remain available."
                                                   Style="{StaticResource SettingDescription}" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Border Style="{StaticResource SettingsCard}" Margin="0,8,0,4"
                                    Visibility="{Binding HasAvailableUpdate, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='Version {0} available'}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="WHAT'S NEW" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding AvailableUpdateNotes, Mode=OneWay}"
                                             IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             FontSize="13" TextWrapping="Wrap" MaxHeight="260"
                                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"
                                             AutomationProperties.Name="Release notes" />
                                    <Button Content="Update now"
                                            Command="{Binding InstallUpdateCommand}"
                                            IsEnabled="{Binding IsUpdateBusy, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                            Style="{StaticResource SettingsButton}"
                                            HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Local usage data -->
                        <StackPanel x:Name="LocalUsageDataPage" Style="{StaticResource SettingsPage}">
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="Usage reports read local Claude and Codex logs and estimate their API list-price value. This is not your subscription bill. Parsed files are cached locally to make later reports fast."
                                               Style="{StaticResource SettingDescription}" Margin="0,0,0,14" />
                                    <DockPanel>
                                        <Button Content="Clear cache" Command="{Binding ClearUsageCacheCommand}"
                                                IsEnabled="{Binding IsClearingUsageCache, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                                Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding UsageCacheSummary}" Style="{StaticResource SettingLabel}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                                    </DockPanel>
                                    <TextBlock Text="After clearing, the next usage report performs a slower full scan."
                                               Style="{StaticResource SettingDescription}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Usage history" Style="{StaticResource GroupHeader}" />
                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,20,0">
                                            <TextBlock Text="Keep usage history" Style="{StaticResource SettingLabel}" />
                                            <TextBlock Text="Claude Code deletes its logs after 30 days. AI Usage Tray saves their token counts so usage reports keep showing older usage. No message content is saved."
                                                       Style="{StaticResource SettingDescription}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding HistoryRetentionOptions}"
                                                  SelectedItem="{Binding SelectedHistoryRetentionOption}"
                                                  AutomationProperties.Name="Keep usage history" />
                                    </Grid>
                                    <Border Style="{StaticResource CardDivider}" />
                                    <DockPanel>
                                        <Button Content="Delete history" Command="{Binding RequestDeleteHistoryCommand}"
                                                IsEnabled="{Binding IsDeletingHistory, Converter={x:Static local:BoolNegationConverter.Instance}}"
                                                Style="{StaticResource SettingsButton}" DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding UsageHistorySummary}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,0,16,0" />
                                    </DockPanel>
                                    <Border x:Name="HistoryDeleteConfirmationPanel" CornerRadius="8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            Background="{DynamicResource PanelBgBrush}" Padding="14" Margin="0,12,0,0"
                                            Visibility="{Binding IsHistoryDeleteConfirmationVisible, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel>
                                            <TextBlock Text="Delete all usage history?" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                            <TextBlock Text="Usage before now will no longer appear in AI Usage Tray, even if the logs are still on disk. This cannot be undone."
                                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding CancelDeleteHistoryCommand}"
                                                        Style="{StaticResource SettingsButton}" />
                                                <Button Content="Delete history" Command="{Binding ConfirmDeleteHistoryCommand}"
                                                        Style="{StaticResource SettingsButton}" Margin="8,0,0,0"
                                                        BorderBrush="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
