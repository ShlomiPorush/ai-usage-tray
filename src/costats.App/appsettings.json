{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Debug" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Debug" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Costats": {
    "Update": {
      "Enabled": true,
      "Repository": "ShlomiPorush/ai-usage-tray",
      "CheckIntervalHours": 6,
      "AllowPrerelease": false,
      "ApplyStagedUpdateOnStartup": true
    },
    "RemoteView": {
      "UploadUrl": "https://ai.yaaps.net",
      "PageUrl": "https://ai.yaaps.net"
    },
    "Pricing": {
      "CatalogUrl": "https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json",
      "RefreshIntervalHours": 24
    }
  }
}
