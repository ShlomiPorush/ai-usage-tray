# Copy to .env next to docker-compose.yml and fill in. Do not set these in the shell: shell values
# override .env.

# The release to run, a version tag of ghcr.io/shlomiporush/ai-usage-tray such as 1.11.1.
VERSION=

# The host name readers open, for example ai.example.com. Traefik routes it to this service.
DOMAIN=

# Optional settings. Each one is described in remote/server/README.md. Remove the "# " to set one;
# leave the rest commented out, because an empty value is not the same as unset.

# Push signing key. By default the server creates /data/vapid.json on first start.
# VAPID_KEY_PATH=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Comma-separated push-service hosts that replace the built-in list.
# PUSH_ENDPOINT_ALLOWED_HOSTS=

# Write throttling.
# SNAPSHOT_SIGNING_KEY=
# UNSIGNED_PUT_PER_MINUTE=
# SIGNED_PUT_PER_MINUTE=

# Cloudflare cache purge once at startup: files or everything.
# CLOUDFLARE_PURGE_ON_START=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
# The address readers use, for example https://ai.example.com. Required for the files purge.
# PUBLIC_BASE_URL=
